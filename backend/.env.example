# RiskReveal backend settings. Copy to backend/.env and fill in the blanks.
# NEVER commit .env. Real environment variables override this file.

ENVIRONMENT=development
DEBUG=false

# Docker dev database from infra/docker-compose.yml (port 5433). Use the
# password from infra/.env.
DATABASE_URL=postgresql+psycopg://riskreveal:CHANGE_ME@localhost:5433/riskreveal
# Docker dev Redis (port 6380).
REDIS_URL=redis://localhost:6380/0

# Required, no defaults. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

CORS_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT=5/minute

# --- Scanning -------------------------------------------------------------
# Allow scanning loopback / private networks (RFC 1918)? Leave false unless you
# are scanning your own lab network.
SCAN_PRIVATE_RANGES_ALLOWED=false
# Public targets that may be scanned, comma separated: exact hostnames, single
# IPs or CIDR ranges (no wider than /16). Empty means NO public scanning.
# Only list systems you own or have written permission to test.
SCAN_PUBLIC_ALLOWLIST=
SCAN_RATE_LIMIT=10/minute
SCAN_MAX_ACTIVE_PER_USER=3
# Full path to nmap.exe if it is not on PATH; leave empty otherwise.
NMAP_PATH=

# --- Accounts -----------------------------------------------------------------
# Set to false once the accounts you need exist. Until target-ownership
# verification is built, every account can scan any target the scan policy allows.
REGISTRATION_ENABLED=true

# --- Vulnerability matching and threat feeds -----------------------------------
# Compare detected versions with the NVD's CVE data after each scan.
VULN_MATCHING_ENABLED=true
# Optional free key from https://nvd.nist.gov/developers/request-an-api-key
# (about ten times faster NVD requests). Leave empty for none. Never commit it.
NVD_API_KEY=
# Hours a product's CVE data is reused before it is fetched again (1-720).
NVD_CACHE_HOURS=24
# Keep CISA KEV and FIRST EPSS fresh automatically (worker start + scheduler).
FEED_REFRESH_ENABLED=true
